import time
from XRPLib.differential_drive import DifferentialDrive

differentialDrive = DifferentialDrive.get_default_differential_drive()


print('Make sure there is enough space for the robot to move safely.')
time.sleep(1)
print('The program will start in 3...')
time.sleep(0.9)
print('The program will start in 2...')
time.sleep(0.9)
print('The program will start in 1...')
time.sleep(0.9)
differentialDrive.straight(18, 0.5)
differentialDrive.straight((-18), 0.5)
time.sleep(0.2)
differentialDrive.turn(90, 0.5)
time.sleep(0.2)
differentialDrive.turn(90, 0.5)
time.sleep(0.2)
differentialDrive.straight(18, 0.5)
print('The movement sequence is complete.')



