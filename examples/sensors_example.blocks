import time
from XRPLib.rangefinder import Rangefinder
from XRPLib.reflectance import Reflectance

rangefinder = Rangefinder.get_default_rangefinder()

reflectance = Reflectance.get_default_reflectance()


print('The robot will now measure the distance 10 times.')
time.sleep(1)
for count in range(10):
  print('Distance value:')
  print(rangefinder.distance())
  print('------------')
  time.sleep(0.9)
print('The robot will now read the reflectance sensor values 10 times.')
time.sleep(1)
for count2 in range(10):
  print('Left reflectance value:')
  print(reflectance.get_left())
  print('Right reflectance value:')
  print(reflectance.get_right())
  print('-------------')
  time.sleep(0.9)
print('The sensor readings are complete.')



