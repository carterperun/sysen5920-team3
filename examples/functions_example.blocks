from XRPLib.differential_drive import DifferentialDrive
import time

movingValue = None

differentialDrive = DifferentialDrive.get_default_differential_drive()

def moveBack(movingValue):
  differentialDrive.straight(movingValue, 0.5)
  time.sleep(0.5)
  movingValue = movingValue * -1
  differentialDrive.straight(movingValue, 0.5)


print('In this program, the robot will move a greater distance each time.')
time.sleep(1)
print('Starting with the shortest distance.')
moveBack(10)
print('Now the robot will move farther.')
time.sleep(1)
moveBack(15)
print('Now it will move even farther.')
time.sleep(1)
moveBack(20)
print('Finally, the robot will move the farthest distance.')
time.sleep(1)
moveBack(30)
print('The movement sequence is complete.')



